{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "PLAYBOOK_BUILDER_CHECK": "bash scripts/builder_check.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/git_guardrails.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
